# AWV1 Ignition Candidate visible-console fragment.
# Merge after x86_64_defconfig; set CONFIG_INITRAMFS_SOURCE to the local generated list separately.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=tty0 loglevel=7 init=/init"
CONFIG_CMDLINE_OVERRIDE=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
